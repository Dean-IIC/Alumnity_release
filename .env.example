# Copy to .env.local (never committed) and fill in.

# Email: the code and reset emails. Without these, development saves emails to
# .mail-outbox/ (read them at /dev/mail) and production refuses to start sign-ups.
# Google Workspace / Gmail: smtp.gmail.com, port 465, the account's address, and an
# app password (Google Account → Security → App passwords), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=alumni@hkbk.edu.in
SMTP_PASS=
MAIL_FROM="Alumnity <alumni@hkbk.edu.in>"

# Where the college register is, if not data/college-records.csv.
# ALUMNITY_REGISTER=

# Where the accounts database lives, if not data/alumnity.db.
# ALUMNITY_DB=

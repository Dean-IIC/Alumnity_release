# Copy to .env.local (never committed) and fill in. In production, set the same in Vercel.
# Where each comes from, and the Supabase settings that go with them: docs/deploy.md.

# Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only.
SUPABASE_SERVICE_ROLE_KEY=

# Secret. Project Settings → Database → Connection string → Transaction pooler (port 6543).
DATABASE_URL=

# Roles set here can't be changed or removed from the site (comma-separated emails).
ALUMNITY_SUPER_ADMINS=
# ALUMNITY_ADMINS=

# Donations (Razorpay). Test-mode keys first (rzp_test_…).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Phone notifications: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:alumni@hkbk.edu.in

# The daily email digest (the same mailbox as Supabase's SMTP).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=alumni@hkbk.edu.in
# SMTP_PASS=
# MAIL_FROM="Alumnity <alumni@hkbk.edu.in>"
# CRON_SECRET=
# ALUMNITY_SECRET=
# SITE_URL=https://alumnity.hkbk.edu.in
